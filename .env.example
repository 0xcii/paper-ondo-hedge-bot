# PaperTrade 钱包私钥（用于注册 Session Key 和签名）
# 格式: 0x 开头的 64 位 hex
PAPER_WALLET_PRIVATE_KEY=your_private_key_here

# PaperTrade Session Key（可选，运行 register 命令后填入可避免重复注册）
# 留空则每次启动自动注册新的 Session Key
PAPER_SESSION_KEY=

# ONDO Perps API 凭证
ONDO_KEY_ID=ondoKeyId_your_key_id
ONDO_API_SECRET=ondoApiSecret_your_secret

# ── 运行模式 ──
# mock = 模拟模式（不进行真实交易，用于演示和测试）
# real = 真实模式（进行真实交易，需要配置凭证）
HEDGE_MODE=mock

# ── 对冲策略参数 ──
# 交易对: BTC 或 ETH
HEDGE_SYMBOL=BTC
# 每侧名义仓位价值 (USD)
HEDGE_POSITION_SIZE=50
# PaperTrade 杠杆 (1-1000)
HEDGE_PAPER_LEVERAGE=10
# ONDO 杠杆 (BTC/ETH 最大 25)
HEDGE_ONDO_LEVERAGE=10
# 触发平仓的价格变动百分比
HEDGE_TARGET_MOVE_PCT=1.0
# 最大持仓秒数
HEDGE_MAX_HOLD_SECONDS=3600
# 价格轮询间隔秒数
HEDGE_POLL_INTERVAL=10
# 最大循环轮次
HEDGE_MAX_CYCLES=200
# 开仓方向: random | paper_long | paper_short
HEDGE_DIRECTION=random
